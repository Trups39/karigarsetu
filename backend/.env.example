# Copy to .env (or set these in your hosting panel)
# Database. SQLite (default, no setup):
DATABASE_URL=
INTERNAL_API_KEY=
DEMO_TODAY=2026-11-16
# Sample suppliers (Kolhapur Chappal Kendra, Patil Chappal Udyog) and their past orders, loaded with the tables
SAMPLE_MAKERS=true
SEED_DEMO_ORDERS=true
# Your real retailer test phone (country code, no +): becomes Pune Footwear House after every reset
DEMO_RETAILER_PHONE=
DEMO_MODE=true

# Supplier login (email + password) and admin approval at /admin
# ADMIN_EMAIL + ADMIN_PASSWORD: the admin login for /admin. When set, /docs is admin-only too. Use a long one on the VPS.
ADMIN_EMAIL=
ADMIN_PASSWORD=
SUPPORT_EMAIL=
SUPPLIER_SESSION_DAYS=14
# true on the VPS (HTTPS), false on your laptop
COOKIE_SECURE=false

# Email on our GoDaddy domain (Titan): website contact form + "new supplier" alerts.
# The password goes ONLY here (backend/.env), never in the code or the repo.
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
CONTACT_TO=
# The public address of the site (used in the alert email's /admin link)
PUBLIC_URL=https://karigarsetu.co.in

# The KarigarSetu WhatsApp bot number (Meta), digits only: "Order on WhatsApp" buttons open it
BOT_WHATSAPP_NUMBER=

# Claude (Sales Agent and Operations Agent)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Which WhatsApp service to use: meta, twilio or none. Empty = automatic (Meta if filled in below).
WHATSAPP_PROVIDER=meta

# WhatsApp via Meta Cloud API (developers.facebook.com → your app → WhatsApp → API Setup)
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_VERSION=v25.0


