# KarigarSetu settings. Copy this file to backend/.env and fill in your own values.
# backend/.env holds real keys and passwords: it is in .gitignore and must never be committed.
# An empty value means "use the default" (shown in brackets). Restart the server after any change.

# ---------- Database ----------
# Empty = SQLite file (no setup). PostgreSQL: postgresql+psycopg://USER:PASSWORD@localhost:5432/karigarsetu
DATABASE_URL=
# Docker (docker-compose.yml): the database password. Then DATABASE_URL=postgresql+psycopg://karigarsetu:THIS_PASSWORD@db:5432/karigarsetu
POSTGRES_PASSWORD=

# ---------- Claude (Sales Agent and Operations Agent) ----------
ANTHROPIC_API_KEY=
# [claude-sonnet-5-5]
CLAUDE_MODEL=

# ---------- WhatsApp (Meta Cloud API: developers.facebook.com → your app → WhatsApp → API Setup) ----------
# meta or none [empty = Meta if the settings below are filled in]
WHATSAPP_PROVIDER=
# "Generate access token" (starts with EAA)
META_WHATSAPP_TOKEN=
# "Phone number ID" (not the phone number itself)
META_PHONE_NUMBER_ID=
# Any secret word; type the same word in Meta's webhook form
META_VERIFY_TOKEN=
# App settings → Basic → App secret
META_APP_SECRET=
# The bot's WhatsApp number, digits with country code: "Order on WhatsApp" buttons open it
BOT_WHATSAPP_NUMBER=

# ---------- Admin login (/admin; also locks /docs when set) ----------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- Email (GoDaddy Titan): contact form + "new supplier" alerts ----------
# [smtp.titan.email]  (or smtpout.secureserver.net)
SMTP_HOST=
# [465]
SMTP_PORT=
# The mailbox, e.g. contact@yourdomain
SMTP_USERNAME=
SMTP_PASSWORD=
# Where contact-form messages go
CONTACT_TO=
# Shown to rejected suppliers
SUPPORT_EMAIL=

# ---------- Running online ----------
# The site's public address, e.g. https://yourdomain [http://localhost:8000]
PUBLIC_URL=
# true on the server (HTTPS) [false]
COOKIE_SECURE=
# A long random secret for the internal testing endpoints [dev-internal-key: change it online]
INTERNAL_API_KEY=

# ---------- Sample data and demo ----------
# Load the sample suppliers and their past orders with the tables [true]
SAMPLE_MAKERS=
SEED_DEMO_ORDERS=
# Your retailer test phone (digits with country code): becomes Pune Footwear House after every reset
DEMO_RETAILER_PHONE=
# "Simulate" buttons on the dashboard [true]; false once real makers use it
DEMO_MODE=
# Fix "today" for a repeatable demo, YYYY-MM-DD [empty = real date]
DEMO_TODAY=
